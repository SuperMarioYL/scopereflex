{
  "name": "scopereflex",
  "version": "0.1.0",
  "description": "Counterfactual contraction-reflex for over-producing coding agents. Forks a do-less plan variant and surfaces a structural contraction-diff with a human acceptance gate.",
  "type": "module",
  "license": "MIT",
  "author": "SuperMarioYL",
  "homepage": "https://github.com/SuperMarioYL/scopereflex",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperMarioYL/scopereflex.git"
  },
  "bugs": {
    "url": "https://github.com/SuperMarioYL/scopereflex/issues"
  },
  "keywords": [
    "coding-agent",
    "agent",
    "cli",
    "contraction-diff",
    "scope-control",
    "plan-approval",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "scopereflex": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "SKILL.md",
    "VERSION"
  ],
  "scripts": {
